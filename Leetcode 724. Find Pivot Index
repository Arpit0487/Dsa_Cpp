class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int total = accumulate(nums.begin(), nums.end(),0);
        int Lsum = 0;
        for(int i=0; i<nums.size(); i++){
            if(Lsum==total-Lsum-nums[i]) return i;
            Lsum += nums[i];
        }
        return -1;
    }
};
