class Solution {
public:
    vector<string> uncommonFromSentences(string s1, string s2) {
        unordered_map<string,int> mp;
        stringstream ss(s1);
        string a;
        while(ss >> a){
            mp[a]++;
        }
        stringstream st(s2);
        while(st >> a){
            mp[a]++;
        }
        vector<string> ans;
        for(auto x : mp){
            if(x.second==1) ans.push_back(x.first);
        }
        return ans;
    }
};
