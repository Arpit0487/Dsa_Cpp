class Solution {
public:
    vector<string> createGrid(int m, int n) {
        if(m==1){
            vector<string> ans(1,".");
            for(int i=1; i<max(m,n); i++) ans[0].push_back('.');
            return ans;
        }

        if(n==1){
            vector<string> ans(m,".");
            return ans;
        }

        vector<string> ans(m);
        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(i==0) ans[i].push_back('.');
                else if(j!=n-1) ans[i].push_back('#');
                else ans[i].push_back('.');
            }
        }
        
        return ans;
    }
};
