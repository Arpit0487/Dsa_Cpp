class Solution {
public:
    bool validPath(int n, vector<vector<int>>& edges, int source, int destination) {
        if(source==destination || n==1) return true;

        //to solve this we first have to convert the given 2D vector of edges into list of connected nodes from each particular node to traverse easily
        vector<vector<int>> map(n);
        for(int i=0; i<edges.size(); i++){
            //the edges given are bi directional so we need to push the opposite also 
            map[edges[i][0]].push_back(edges[i][1]);
            map[edges[i][1]].push_back(edges[i][0]);
        }

        vector<int> vis(n,0);

        queue<int> q;
        q.push(source);
        while(!q.empty()){
            int curr = q.front();
            q.pop();
            for(int i=0; i<map[curr].size(); i++){
                if(!vis[map[curr][i]]){
                    vis[map[curr][i]] = 1;
                    q.push(map[curr][i]);
                }
            }
        }

        return vis[destination];
    }
};
