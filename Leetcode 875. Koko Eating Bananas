class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1;
        int high = *max_element(piles.begin(),piles.end());
        int mid = low + (high-low) / 2;

        while(low<high){
            mid = low + (high-low) / 2;
            int time = 0;
            for(auto x : piles){
                if(x<mid) time++;
                else if(x%mid!=0){
                    time += x/mid;
                    time++;
                }
                else time+=x/mid;
            }
            if(time>h) low = mid+1;
            else high = mid;
        }
        return low;
    }
};
