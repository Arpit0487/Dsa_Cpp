class Solution {
public:
    ListNode* mergeNodes(ListNode* head) {
        ListNode* ans = new ListNode(0);
        ListNode* temp = ans;
        int sum = 0;
        while(head){
            if(head->val==0 && sum!=0){
                ListNode* a = new ListNode(sum);
                temp->next = a;
                temp = temp->next;
                sum = 0;
            }
            else{
                sum += head->val;
            }
            head=head->next;
        }
        return ans->next;
    }
};
