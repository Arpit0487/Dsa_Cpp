class Solution {
public:
    bool isIsomorphic(string s, string t) {
        vector<vector<char>> mp(256);

        for(int i = 0; i < s.length(); i++) {
            mp[(unsigned char)s[i]].push_back(t[i]);
        }

        for(int i = 0; i < 256; i++) {
            if(mp[i].size() <= 1) continue;

            char ch = mp[i][0];
            for(int j = 1; j < mp[i].size(); j++) {
                if(mp[i][j] != ch) return false;
            }
        }

        // Reverse mapping check
        vector<vector<char>> rev(256);

        for(int i = 0; i < t.length(); i++) {
            rev[(unsigned char)t[i]].push_back(s[i]);
        }

        for(int i = 0; i < 256; i++) {
            if(rev[i].size() <= 1) continue;

            char ch = rev[i][0];
            for(int j = 1; j < rev[i].size(); j++) {
                if(rev[i][j] != ch) return false;
            }
        }

        return true;
    }
};
